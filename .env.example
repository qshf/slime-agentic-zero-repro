# A2 AgentFlow —— python_coder 内部 coder 模型（外部 DeepSeek API）配置模板。
#
# 用法：复制成 .env（.env 已被 .gitignore 忽略，绝不进 git），填入真实 key。
#   cp .env.example .env  &&  编辑 .env 填 DEEPSEEK_API_KEY
# python_coder.py 顶部 load_dotenv() 会自动加载；也可继续用内联 `DEEPSEEK_API_KEY=... uv run ...`。
#
# 只有 data/generate/reward 路径指向 agentflow 时才会用到这些；calculator/memagent 不读。

DEEPSEEK_API_KEY=sk-your-key-here
# 可选（有默认值，通常不用改）：
# CODER_BASE_URL=https://api.deepseek.com/v1
# CODER_MODEL=deepseek-v4-flash
